PORT=4000
# DRY_RUN=1 simulates every step (no Docker, no Kubernetes, no AWS). Set 0 for real deployments.
DRY_RUN=1
DATA_DIR=./workspace

# Who runs the pipeline:  local (scripts on this machine, through WSL on Windows)  |  jenkins
ORCHESTRATOR=local
# Where apps run:  microk8s (this machine, free)  |  aws (one EC2 server with k3s, free-tier limits apply)
TARGET=microk8s
# (The old MODE variable still works: MODE=jenkins or MODE=aws.)

# --- always needed for real deployments ---
DOCKER_USER=
DOCKER_TOKEN=
# Only if MicroK8s is not at /snap/bin/microk8s inside WSL/Ubuntu:
# MICROK8S_BIN=

# --- TARGET=aws only ---
SSH_KEY_PATH=/home/you/.ssh/autodeployers.pem
# t3.micro works on every AWS account type. Accounts created after 15 Jul 2025 may also use t3.small.
INSTANCE_TYPE=t3.micro
# AWS credentials: `aws configure` inside WSL, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.

# --- ORCHESTRATOR=jenkins only ---
JENKINS_URL=http://localhost:8080
JENKINS_JOB=autodeployers
JENKINS_USER=
JENKINS_TOKEN=

# --- accounts (RBAC): seeded once on first run, change the passwords ---
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
VIEWER_USER=viewer
VIEWER_PASSWORD=viewer123
AUTH_SECRET=change-this-to-a-random-string

# --- AI (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
